    {"name": "TD_loading",                  "min": null,   "max": null,   "type": "bool",  "description": "True = 2D transverse loading; False = standard."},
    {"name": "calibration_precession_time", "min": 0.1,    "max": 20.0,   "type": "float", "description": "Ramsey wait time for Larmor calibration (ms)."},
    {"name": "rf_larmor_frequency",         "min": 10000,  "max": 11000,  "type": "float", "description": "Larmor frequency (Hz); add correction after calibration."},
    {"name": "clock_pi_resonance_frequency_list", "min": null, "max": null, "type": "float", "description": "Clock light frequency per shot (MHz); sweep ± 1 MHz around clock_pi_resonance_frequency."}
