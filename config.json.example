{
  "_comment": "Template for an apparatus config. Copy to config.json (the default apparatus, named 'testbench') or to config.<name>.json for a named one; both are git-ignored, so a real apparatus config never leaves this machine. Easier than editing this by hand: run the agent with no config at all and pick 'new lab', which asks for the name, the data folder and the globals and writes the file for you.",

  "MEMORY_DATA_PATH": "local_data",
  "_comment_MEMORY_DATA_PATH": "Where this apparatus's shot files live. A relative path is resolved against the folder CONTAINING this repo, so renaming or moving the project keeps working; an absolute path is also accepted.",

  "LABSCRIPT_SUITE_PATH": "",
  "_comment_LABSCRIPT_SUITE_PATH": "Leave empty to fall back to LABSCRIPT_SUITE_PROFILE or ~/labscript-suite.",

  "EXEC_IMPORT": "import time, os, sys, json\nimport numpy as np\nimport matplotlib.pyplot as plt\n",

  "sequences": [
    {
      "file": "sequences/<your_sequence>.py",
      "description": "What this sequence does, in one line.",
      "use_case": "resonance",
      "key_globals": ["<global_it_sweeps>"]
    }
  ],

  "analysis_scripts": [
    {
      "file": "analysis/scripts/<your_analysis>.py",
      "description": "What this routine reduces a shot to.",
      "editable_fields": {},
      "use_case": ["resonance"]
    }
  ],

  "globals": [
    {"name": "<global_name>", "min": 0.0, "max": 1.0, "type": "float", "description": "One parameter this apparatus has, with its real bounds."}
  ],
  "_comment_globals": "Every sweep is range-checked against these, and creative mode's code guard checks generated code against them, so the bounds have to be the real ones, not aspirational. A global that is absent here cannot be swept at all."
}
